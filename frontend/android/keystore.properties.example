# Copy this file to `frontend/android/keystore.properties` after creating the
# upload keystore. The real file and keystore are ignored by Git.
#
# `storeFile` may be an absolute path, which is recommended so the upload key
# can be backed up outside the repository.
storeFile=/absolute/path/to/kim-math-upload.jks
storePassword=replace-with-a-strong-password
keyAlias=kim-math-upload
keyPassword=replace-with-a-strong-password
